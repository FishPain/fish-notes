# Copy to .env and fill in your key. The app talks to an OpenAI-compatible proxy
# for chat (draft + /llm), OCR (screen capture), and embeddings.
#
#   dev (npm run dev):   this file lives at app/.env
#   packaged app:        place it at ~/Library/Application Support/Fish Notes/.env
#
# NOTE: .env is git-ignored and is NOT bundled into packaged builds — never commit
# a real key, and don't share a build expecting the key to travel with it.

CANVAS_AI_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:6655/openai/v1
OPENAI_API_KEY=

# Chat model for /ask + note drafting/completion
CANVAS_AI_MODEL=gpt-5-mini
# Vision model for screen-capture OCR (must accept images)
CANVAS_OCR_MODEL=gpt-4.1-mini

# Embeddings (reuse OPENAI_BASE_URL + OPENAI_API_KEY above)
CANVAS_EMBED_MODEL=text-embedding-3-small
CANVAS_EMBED_DIM=1536
