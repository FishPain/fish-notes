{
  "name": "canvas-notes-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "test": "npm run rebuild:node && vitest run",
    "typecheck": "tsc --noEmit",
    "start": "npm run rebuild:node && tsx src/index.ts",
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build:app": "electron-vite build",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^4.0.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.2",
    "luxon": "^3.4.0",
    "ollama-ai-provider": "^1.0.0",
    "sqlite-vec": "^0.1.6",
    "yup": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^5.16.0",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@tanstack/react-query": "^5.51.0",
    "zustand": "^4.5.0",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "electron": "^31.0.0",
    "electron-vite": "^2.3.0",
    "vite": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@electron/rebuild": "^3.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
